# Copy to .env (git-ignored). Test-environment credentials only - never production.
MINIACC_URL=http://localhost:4100
MINIACC_PASSWORD_STAFF1=Test@123
MINIACC_PASSWORD_MANAGER1=Test@123
MINIACC_PASSWORD_MANAGER2=Test@123

# Test mailbox for the "mail" probe (Mailpit / MailHog-compatible API)
# MAILPIT_URL=http://localhost:8025

# Origins the "http" probe may read (comma-separated)
QA_PROBE_ALLOWED=http://localhost:4100

# TOTP secrets (base32) for MFA test accounts, used by tools/login-state.js via totpEnv
# PROJECTX_TOTP_STAFF1=JBSWY3DPEHPK3PXP

# Browser channel for Playwright scripts (chrome = installed Google Chrome)
QA_BROWSER_CHANNEL=chrome
